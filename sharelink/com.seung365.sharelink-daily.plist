<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 매일 06:30 쉐어링크 후보 수집. 설치: cp 이 파일 ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.seung365.sharelink-daily.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.seung365.sharelink-daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd ~/automation-/sharelink &amp;&amp; git pull -q --ff-only; node daily.mjs</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/sharelink-daily.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/sharelink-daily.log</string>
</dict>
</plist>
